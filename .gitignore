# macOS 构建产物
macos/build/
macos/dist/
macos/*.app/

# Windows 构建产物
windows/**/bin/
windows/**/obj/
windows/**/publish/
windows/dist/

# 系统文件
.DS_Store

# 本地临时测试产物
/tmp-recv/

# 本机测试脚本与截图（生成物）
/windows/artifacts/
/windows/screenshots/

# Android 构建产物 / 本机配置
mobile/android/.gradle/
# 本地签名密钥与密码（绝不提交）
mobile/android/keystore/
mobile/android/**/build/
mobile/android/local.properties
mobile/android/.idea/
mobile/android/*.iml
mobile/android/.kotlin/

# iOS 构建产物 / Xcode 用户数据
mobile/ios/build/
mobile/ios/DerivedData/
mobile/ios/.build/
mobile/ios/**/*.xcuserstate
mobile/ios/**/xcuserdata/
mobile/ios/*.xcodeproj/xcuserdata/
mobile/ios/*.xcworkspace/xcuserdata/

# Python 测试缓存
mobile/tests/__pycache__/
