<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ADBTypeLink.App.MainWindow"
        Title="文件互传助手"
        Icon="/Assets/app-icon.png"
        Width="1120" Height="740"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

  <TabControl x:Name="MainTabs" Padding="0" Classes="mainTabs">
    <TabControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" />
      </ItemsPanelTemplate>
    </TabControl.ItemsPanel>

    <TabItem Header="移动设备">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch">

          <!-- 设备 -->
          <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="设备" Classes="metaDim" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                               IsVisible="{Binding Mobile.Scanning}" VerticalAlignment="Center" />
                  <Button Classes="link" Content="截屏" Click="OnMobileScreenshot"
                          IsEnabled="{Binding Mobile.HasDevices}"
                          ToolTip.Tip="截取手机当前屏幕" />
                  <Button Classes="icon" Content="↻" Click="OnMobileRefresh"
                          ToolTip.Tip="刷新设备列表" />
                </StackPanel>
              </Grid>

              <ComboBox ItemsSource="{Binding Mobile.Devices}"
                        SelectedItem="{Binding Mobile.SelectedDevice, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding Mobile.HasDevices}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <StackPanel Spacing="2" IsVisible="{Binding Mobile.NoDevices}">
                <TextBlock Text="未检测到设备" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding Mobile.DeviceErrorText}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 发送文字 -->
          <TextBlock Text="发送文字" Classes="sectionTitle" Margin="2,4,0,0" />
          <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="发送内容" Classes="metaDim" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="清空输入" Click="OnMobileClearInput" />
              </Grid>

              <TextBox x:Name="MobileInputBox"
                       Text="{Binding Mobile.Input, Mode=TwoWay}"
                       Watermark="输入要发送的文字，中文也可以"
                       FontSize="20" Padding="12,8" />

              <StackPanel Orientation="Horizontal" Spacing="18">
                <CheckBox Content="先清空设备输入框" IsChecked="{Binding Mobile.ClearFirst, Mode=TwoWay}"
                          IsEnabled="{Binding !Mobile.NeedsClipboard}" />
                <CheckBox Content="发送后按回车键" IsChecked="{Binding Mobile.PressEnter, Mode=TwoWay}"
                          IsEnabled="{Binding !Mobile.NeedsClipboard}" />
              </StackPanel>

              <TextBlock Text="{Binding Mobile.ClipboardHint}" Classes="metaDim" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Button Classes="primary" Content="{Binding Mobile.SendButtonText}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  IsEnabled="{Binding Mobile.CanSend}" Click="OnMobileSend" />

          <TextBlock Text="{Binding Mobile.StatusText}" Classes="statusText"
                     Classes.failure="{Binding Mobile.StatusIsFailure}" TextWrapping="Wrap" />

          <!-- 最近发送 -->
          <StackPanel Spacing="6" IsVisible="{Binding Mobile.HasHistory}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="最近发送" Classes="metaDim" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Content="清除记录" Click="OnMobileClearHistory" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Mobile.History}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="secondary" Margin="0,0,6,6" Padding="10,4"
                          Content="{Binding}" Click="OnMobileUseHistory"
                          ToolTip.Tip="点击填入输入框" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 保存到手机 -->
          <TextBlock Text="文件传输" Classes="sectionTitle" Margin="2,4,0,0" />
          <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="保存到手机" Classes="metaDim" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="恢复默认" Click="OnMobileResetTargetDir" />
              </Grid>
              <TextBox Text="{Binding Mobile.TargetDir, Mode=TwoWay}"
                       FontFamily="Consolas,Menlo,monospace" />
              <TextBlock Text="{Binding Mobile.TargetDeviceText}" Classes="metaDim" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="secondary" Content="选择文件…" Click="OnMobileChooseFiles" />
            <Button Classes="link" Content="清空列表" Click="OnMobileClearFiles"
                    IsVisible="{Binding Mobile.HasFiles}" />
          </StackPanel>

          <!-- 待传文件 -->
          <StackPanel Spacing="6" IsVisible="{Binding Mobile.HasFiles}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="待传文件" Classes="metaDim" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Mobile.TotalSizeText}" Classes="metaDim" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Mobile.Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10,7"
                          Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SizeText}" Classes="metaDim"
                                   IsVisible="{Binding !IsSending}" />
                        <ProgressBar Value="{Binding Progress}" Maximum="1" Height="4"
                                     IsVisible="{Binding IsSending}" />
                        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}"
                                   IsVisible="{Binding HasMessage}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding BadgeText}" Classes="metaDim"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="link" Content="✕" Click="OnMobileRemoveFile" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Mobile.PendingText}" Classes="metaDim" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="primary" Content="传到手机"
                      IsEnabled="{Binding Mobile.CanPushFiles}" Click="OnMobilePush" />
            </Grid>
          </StackPanel>

          <!-- adb 状态 -->
          <Grid ColumnDefinitions="*,Auto" Margin="2,8,2,0">
            <TextBlock Text="{Binding Mobile.AdbFooterText}" Classes="metaDim" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="link" Content="重启 adb" Click="OnMobileRestartAdb"
                      ToolTip.Tip="重启 adb 服务端：5037 被模拟器 / 手机助手占用时用这个恢复（会断开其它工具的连接）" />
              <Button Classes="link" Content="设置 adb…" Click="OnMobilePickAdb" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="电脑设备">
  <Grid x:Name="RootGrid" ColumnDefinitions="260,*">

    <!-- ============ 左侧：设备列表 + 本机 ============ -->
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <!-- 0:标题 1:附近设备表头 2:可滚动列表 3:配对请求 4:本机(固定) 5:状态栏 -->
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <StackPanel Grid.Row="0" Margin="16,14,16,6" Spacing="2">
          <TextBlock Text="文件互传助手"
                     FontSize="17" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="局域网直连 · 像聊天一样传文字和文件"
                     FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>

        <!-- 附近设备：表头固定，只有下面的列表滚动 -->
        <Grid Grid.Row="1" Margin="14,6,14,4" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="附近设备" Classes="sectionTitle" Margin="0" />
            <Border Background="{DynamicResource RowHoverBrush}" CornerRadius="7" Padding="5,0">
              <TextBlock Text="{Binding PeerCountText}" Classes="metaDim" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="同一局域网" Classes="metaDim" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
          <StackPanel>

            <ItemsControl ItemsSource="{Binding Peers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="peerRow" Classes.selected="{Binding IsSelected}"
                          PointerPressed="OnPeerPressed" Cursor="Hand">
                    <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                      <Border Grid.RowSpan="2" Classes="avatar" Width="28" Height="28" CornerRadius="14"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding AvatarText}" FontSize="12" />
                      </Border>

                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Grid.Column="1" Classes="badge"
                                Classes.paired="{Binding IsPaired}"
                                Classes.unpaired="{Binding CanPair}">
                          <TextBlock Text="{Binding PairBadgeText}" />
                        </Border>
                      </Grid>

                      <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding PresenceText}" Classes="metaDim" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="link" Content="配对…"
                                IsVisible="{Binding CanPairNow}" Click="OnPairPeerClicked" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border IsVisible="{Binding NoPeers}"
                    Background="{DynamicResource CardBrush}" CornerRadius="8"
                    Padding="10,9" Margin="0,4,0,0">
              <StackPanel Spacing="2">
                <TextBlock Text="正在搜索…" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="在另一台电脑上打开「文件互传助手」，并连同一个局域网"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- 配对请求：动作提示，固定在底部区域，不会被列表滚走 -->
        <Border Grid.Row="3" IsVisible="{Binding HasPendingPair}"
                Background="{DynamicResource PendingPairBrush}" CornerRadius="8"
                Padding="10,9" Margin="12,0,12,8">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding PendingPairTitle}" FontSize="12.5" FontWeight="SemiBold"
                       TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
            <TextBlock Text="{Binding PendingPairDetail}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Classes="link" Content="知道了" HorizontalAlignment="Left"
                    Click="OnDismissPairRequest" />
          </StackPanel>
        </Border>

        <!-- 本机：固定在左下角，不随上面的设备列表滚动。
             和 macOS 左侧一样压成三行——少占地方，设备列表就能多显示几台。 -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
          <StackPanel Spacing="5">

            <!-- 本机 <名字>                       清除配对 -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
              <TextBlock Text="本机" Classes="metaDim" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="12.5"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{Binding DeviceName}"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <Button Grid.Column="2" Classes="link" Content="清除配对" FontSize="11"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasPaired}" Click="OnForgetAllPairs" />
            </Grid>

            <!-- 你的配对码  5 6 3 9 6 4        [复制] [换一个] -->
            <StackPanel Spacing="0">
              <TextBlock Text="你的配对码" Classes="metaDim" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding PairingCodeDisplay}" Classes="pairingCode"
                           VerticalAlignment="Center"
                           ToolTip.Tip="对方第一次连接你时输入这个码，输过一次会自动记住" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center">
                  <Button Classes="icon" Content="📋" FontSize="10" Padding="4"
                          Click="OnCopyPairingCode" ToolTip.Tip="复制配对码" />
                  <Button Classes="icon" Content="↻" FontSize="12" Padding="4"
                          Click="OnRegenerateCode" ToolTip.Tip="换一个配对码" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- 📁 接收目录…           修改  [打开] -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
              <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center" Opacity="0.75" />
              <Button Grid.Column="1" Classes="link" Padding="0" FontSize="11.5"
                      HorizontalAlignment="Left" Click="OnOpenReceiveDir"
                      ToolTip.Tip="{Binding ReceiveDir}">
                <TextBlock Text="{Binding ReceiveDir}" TextTrimming="CharacterEllipsis"
                           FontSize="11.5" MaxWidth="150" />
              </Button>
              <Button Grid.Column="2" Classes="link" Content="修改" FontSize="11"
                      VerticalAlignment="Center" Click="OnChangeReceiveDir"
                      ToolTip.Tip="修改接收目录" />
              <Button Grid.Column="3" Classes="icon" Content="📂" FontSize="11" Padding="4"
                      VerticalAlignment="Center" Click="OnOpenReceiveDir"
                      ToolTip.Tip="在文件管理器中打开接收目录" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="14,8">
          <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding StatusSymbol}" Classes="statusText"
                         Classes.success="{Binding StatusIsSuccess}"
                         Classes.failure="{Binding StatusIsFailure}" VerticalAlignment="Top" />
              <TextBlock Text="{Binding StatusText}" Classes="statusText"
                         Classes.success="{Binding StatusIsSuccess}"
                         Classes.failure="{Binding StatusIsFailure}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="首次运行请在 Windows 安全中心 → 防火墙里允许专用网络，否则其它电脑看不到本机"
                       Classes="metaDim" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ============ 右侧：聊天 ============ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <!-- 聊天头部 -->
      <Border Grid.Row="0" Padding="18,10" BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding HeaderTitle}" FontSize="16" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding HeaderStatusText}" Classes="meta" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="secondary" Content="重新连接" IsVisible="{Binding HasSelectedPeer}"
                    Click="OnReconnectSelected"
                    ToolTip.Tip="立即探测一次对方是否可达（只建立 TCP 连接，不会触发对方的配对提示）" />
            <Button Classes="secondary" Content="配对…" IsVisible="{Binding ShowPairButton}"
                    Click="OnPairSelectedPeer" />
            <Button Classes="icon" Content="⋯" ToolTip.Tip="更多">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="设置别名…" Click="OnEditAlias" IsEnabled="{Binding HasSelectedPeer}" />
                  <MenuItem Header="清除全部别名" Click="OnClearAliases" />
                  <Separator />
                  <MenuItem Header="清空记录" Click="OnClearMessages" />
                  <MenuItem Header="修改接收目录…" Click="OnChangeReceiveDir" />
                  <MenuItem Header="在文件管理器中打开接收目录" Click="OnOpenReceiveDir" />
                  <MenuItem Header="打开运行日志…" Click="OnOpenLogFile" />
                  <Separator />
                  <MenuItem Header="隐藏到托盘" Click="OnHideToTray" />
                  <MenuItem Header="退出程序" Click="OnExitApplication" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 消息列表 -->
      <Grid Grid.Row="1">
        <!-- 内边距放在内容里，而不是 ScrollViewer 上：否则这段留白不计入可滚动高度，
             滚到底时最后一条消息会被截掉一截。 -->
        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Border Padding="18,10,18,22">
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="38,*,38" Margin="0,7">
                  <Border Grid.Column="0" Classes="avatar" IsVisible="{Binding IsIncoming}"
                          VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="{Binding AvatarText}" />
                  </Border>

                  <StackPanel Grid.Column="1" Spacing="4"
                              HorizontalAlignment="{Binding BubbleAlignment}">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="{Binding BubbleAlignment}">
                      <TextBlock Text="{Binding SenderLabel}" FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{Binding TimeText}" Classes="metaDim" />
                      <Button Classes="link" Content="复制" FontSize="10" Padding="2,0"
                              IsVisible="{Binding IsText}" Click="OnCopyMessage"
                              ToolTip.Tip="复制这段文字" />
                    </StackPanel>

                    <Border Classes="bubble" Classes.outgoing="{Binding IsOutgoing}"
                            HorizontalAlignment="{Binding BubbleAlignment}"
                            PointerPressed="OnBubblePointerPressed">
                      <StackPanel>
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="500"
                                             IsVisible="{Binding IsText}" Classes="bubbleText" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                              IsVisible="{Binding IsFile}">
                          <TextBlock Text="📄" FontSize="24" VerticalAlignment="Center"
                                     Opacity="{Binding FileIconOpacity}" />
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <!-- 文件被删掉的行，文件名加删除线 -->
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" MaxWidth="330"
                                       Classes="bubbleText"
                                       TextDecorations="{Binding FileNameDecorations}"
                                       Opacity="{Binding FileTextOpacity}" />
                            <TextBlock Text="{Binding FileMeta}" Classes="metaDim" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="link" Content="{Binding OpenButtonText}"
                                  VerticalAlignment="Center" Click="OnRevealFile" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <Border Grid.Column="2" Classes="avatar outgoing"
                          IsVisible="{Binding IsOutgoing}"
                          VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="{Binding AvatarText}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </Border>
        </ScrollViewer>

        <!-- 空状态 -->
        <StackPanel IsVisible="{Binding MessagesEmpty}" VerticalAlignment="Center"
                    HorizontalAlignment="Center" MaxWidth="430" Spacing="6">
          <TextBlock Text="还没有消息" FontSize="15" FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="收到的文字和文件会像聊天一样显示在这里，发出去的内容也会留在上面"
                     FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
      </Grid>

      <!-- 底部固定输入区 -->
      <Border Grid.Row="2" Background="{DynamicResource ComposerBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
              Padding="14,10">
        <StackPanel Spacing="8">

          <!-- 发送进度（带百分比和取消） -->
          <StackPanel Spacing="5" IsVisible="{Binding Busy}">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="{Binding SendLabelText}" Classes="meta"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding SendPercentText}" Classes="meta"
                         Margin="10,0,6,0" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="icon" Content="✕" FontSize="11" Padding="5,2"
                      Click="OnCancelSend" ToolTip.Tip="取消这次发送" />
            </Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding SendProgress}" Height="5" />
          </StackPanel>

          <!-- 发送失败提示（醒目显示，避免用户以为「点了没反应」） -->
          <Border IsVisible="{Binding HasSendError}" Background="{DynamicResource FailureTintBrush}"
                  CornerRadius="8" Padding="10,8"
                  BorderBrush="{DynamicResource FailureBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding SendErrorText}" TextWrapping="Wrap" FontSize="12.5"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource FailureBrush}" />
              <Button Grid.Column="1" Classes="icon" Content="✕" FontSize="11" Padding="5,2"
                      Click="OnDismissSendError" ToolTip.Tip="关闭提示" />
            </Grid>
          </Border>

          <!-- 待发送文件 -->
          <Border IsVisible="{Binding HasStagedFiles}" Background="{DynamicResource CardBrush}"
                  CornerRadius="8" Padding="8,6"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
              <ItemsControl ItemsSource="{Binding StagedFiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource RowHoverBrush}" CornerRadius="7"
                            Padding="8,4" Margin="0,0,6,6">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="220"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SizeText}" Classes="metaDim"
                                   VerticalAlignment="Center" />
                        <Button Classes="icon" Content="✕" FontSize="10" Padding="2"
                                Click="OnRemoveStagedFile" ToolTip.Tip="从待发送列表移除" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StagedSummary}" Classes="meta"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="link" Content="清空" Click="OnClearStagedFiles" />
                  <Button Classes="primary" Content="{Binding StagedButtonText}"
                          IsEnabled="{Binding CanCompose}" Click="OnSendFiles" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- 发给谁 -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding TargetHint}" Classes="meta"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding MessageCountText}" Classes="metaDim"
                       VerticalAlignment="Center" />
          </Grid>

          <!-- 输入行 -->
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Classes="icon" Content="📎" FontSize="18"
                    IsEnabled="{Binding CanCompose}" Click="OnAttachFiles"
                    ToolTip.Tip="选择文件（可多选）" VerticalAlignment="Bottom" />
            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="9"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="2">
              <TextBox x:Name="InputBox"
                       Text="{Binding DraftText, Mode=TwoWay}"
                       Watermark="输入要发送的文字…"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="38" MaxHeight="120"
                       BorderThickness="0" Background="Transparent"
                       IsEnabled="{Binding CanCompose}"
                       Padding="8,6" FontSize="13" />
            </Border>
            <Button Grid.Column="2" Classes="primary" Content="发送" MinWidth="76"
                    IsEnabled="{Binding CanSendText}" Click="OnSendText"
                    VerticalAlignment="Bottom" />
          </Grid>

          <TextBlock Text="Enter 发送 · Shift+Enter 换行 · 可拖拽文件到窗口任意位置加入待发送"
                     Classes="metaDim" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 拖拽高亮 -->
    <Border Grid.ColumnSpan="2" IsVisible="{Binding IsDragOver}" IsHitTestVisible="False"
            Background="#44000000">
      <Border Background="{DynamicResource DropOverlayBrush}" CornerRadius="14"
              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Margin="26">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <TextBlock Text="⬇" FontSize="44" HorizontalAlignment="Center"
                     Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="松开后加入待发送列表" FontSize="16" FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="选好设备后点「发送文件」即可发出" FontSize="12"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
    </TabItem>
  </TabControl>
</Window>
